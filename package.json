{
  "name": "@gorules/jdm-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "lerna": "lerna",
    "build": "lerna run build",
    "test": "lerna run test",
    "typecheck": "lerna run typecheck",
    "lint": "eslint --ext js,ts,jsx,tsx .",
    "lint:fix": "pnpm lint --fix",
    "lint:compiler": "eslint . --config eslint.react-compiler.mjs",
    "lint:debt": "node scripts/style-debt.mjs",
    "prepare": "husky",
    "verify": "run-s lint typecheck lint:compiler lint:debt test",
    "prettier": "prettier --check .",
    "prettier:fix": "pnpm prettier --write",
    "format": "run-s lint prettier",
    "format:fix": "run-s lint:fix prettier:fix",
    "size": "node scripts/bundle-size.mjs",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "test:npm-smoke": "node scripts/npm-smoke.mjs"
  },
  "engines": {
    "pnpm": "~10"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.8",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.24.0",
    "@swc/core": "^1.11.21",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.14.1",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "9.24.0",
    "eslint-config-prettier": "10.1.2",
    "eslint-plugin-file-progress": "^3.0.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "10.5.10",
    "husky": "^9.1.7",
    "lerna": "^8.2.2",
    "lint-staged": "^17.4.1",
    "npm-run-all": "^4.1.5",
    "playwright": "1.62.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core",
      "unrs-resolver"
    ],
    "overrides": {
      "axios@<0.30.0": ">=0.30.0",
      "@lezer/common": "^1.5.2"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,css,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix --no-ignore --color"
    ]
  }
}
