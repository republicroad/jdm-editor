  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/schema": {
      "import": "./dist/schema.js",
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/clean-dist.mjs",
    "build:watch": "vite build --watch",
    "storybook": "storybook dev -p 9009",
    "build:storybook": "storybook build -o docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:storybook": "concurrently -k -s first -n SB,TST \"storybook build -o docs --quiet && http-server docs -p 9009 --silent\" \"wait-on tcp:127.0.0.1:9009 && test-storybook --url http://127.0.0.1:9009\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "vite build"
  },
