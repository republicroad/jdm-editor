    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "catalog:",
    "axios": "^1.13.5",
    "better-auth": "^1.6.25",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
