{
  "name": "@republicroad/jdm-appshell",
  "version": "0.6.0",
  "description": "Application shell for @republicroad/jdm-editor — custom node hosting, UI slot overrides and skinning",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:npm-smoke": "node scripts/npm-smoke.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@republicroad/jdm-editor": ">=0.3.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
